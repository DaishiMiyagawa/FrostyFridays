--内部ステージの作成
CREATE STAGE IF NOT EXISTS my_udf_stage;

--Pythonファイルのアップロード
--GUI

--ステージ上の確認
LIST @my_udf_stage;


--ステージにロードしたpyファイルを元にUDF作成
CREATE OR REPLACE FUNCTION extract_class_value(input_string STRING)
RETURNS STRING
LANGUAGE PYTHON
RUNTIME_VERSION = '3.9'
HANDLER = 'udf.extract_class_value'
IMPORTS = ('@my_udf_stage/udf.py');


--UDFを使用したデータ処理
SELECT 
    id,
    user_id,
    page_url,
    click_time,
    click_location,
    extract_class_value(click_location) AS element_class
FROM website_clicks;



